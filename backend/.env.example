PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/scintillace
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
# Server-side price per guest for the entire stay; do not accept prices from clients.
ACCOMMODATION_PRICING_JSON={"Single":0,"Double":0,"Triple":0,"Dormitory":0}
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
